// Root Nextflow config.
//
// This file is loaded automatically by `nextflow run OlmLab/ZipStrain` (Nextflow
// only auto-loads a file named `nextflow.config`). It makes the pipeline "just
// work" on a laptop with Docker, so the simplest possible invocation is:
//
//   nextflow run OlmLab/ZipStrain \
//     --mode from_sra_to_profile --input_table sra.csv --output_dir out -resume
//
// For HPC, select one of the singularity/slurm profiles from conf.config with
// `-profile fiji` (or gutbot/alpine/blanca), which turn Docker off and use
// Singularity instead.

manifest {
    name          = 'OlmLab/ZipStrain'
    author        = 'Parsa Ghadermazi and Matt Olm'
    homePage      = 'https://github.com/OlmLab/ZipStrain'
    description   = 'Strain-level metagenomic profiling and comparison'
    mainScript    = 'zipstrain.nf'
    defaultBranch = 'main'
}

// Per-process resource requests and the cluster/singularity profiles.
includeConfig 'conf.config'

// ---- Default execution: Docker on the local machine ----
// Docker is enabled by default so no `-profile` is needed for a laptop run.
docker {
    enabled = true
    runOptions = '--platform linux/amd64'   // required on Apple Silicon; harmless on amd64
}

process {
    executor = 'local'
    container = 'parsaghadermazi/zipstrain:0.11.1'
}
