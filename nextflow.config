// Root Nextflow config.
//
// This file is loaded automatically by `nextflow run OlmLab/ZipStrain`. It keeps
// the public pipeline config generic: Docker is the local default, and
// `-profile apptainer` switches to a remote Apptainer image. Site-specific SLURM
// profiles should live in an ignored local config (for example
// `-c conf.local.config -profile <cluster-profile>`).

manifest {
    name          = 'OlmLab/ZipStrain'
    author        = 'Parsa Ghadermazi and Matt Olm'
    homePage      = 'https://github.com/OlmLab/ZipStrain'
    description   = 'Strain-level metagenomic profiling and comparison'
    mainScript    = 'zipstrain.nf'
    defaultBranch = 'main'
}

// Per-process resource requests and generic container profiles.
includeConfig 'conf.config'

// ---- Default execution: Docker on the local machine ----
// Docker is enabled by default so no `-profile` is needed for a laptop run.
docker {
    enabled = true
    runOptions = '--platform linux/amd64'   // required on Apple Silicon; harmless on amd64
}

process {
    executor = 'local'
    container = 'parsaghadermazi/zipstrain:1.0.3'
}
